{
  "name": "sceneops",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "Field and booth ops leads get runnable 3D props in minutes via Aholo Lux3D.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/er-s-an/sceneops.git"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5273 --strictPort",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "verify": "node .cursor/skills/verify-sceneops/scripts/verify.mjs",
    "verify:doctor": "node .cursor/skills/verify-sceneops/scripts/verify.mjs doctor",
    "verify:happy": "node .cursor/skills/verify-sceneops/scripts/verify.mjs happy-path"
  },
  "dependencies": {
    "@manycore/aholo-sdk-asset": "^1.3.0",
    "@manycore/aholo-sdk-core": "^1.3.0",
    "@manycore/aholo-sdk-lux3d": "^1.9.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "playwright": "^1.56.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
